__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.DS_Store
.env

# Don't commit the PDFs you test with, the images extracted from them, or
# the vector index built from them -- these are regenerated by running
# the pipeline, and PDFs especially may not be yours to redistribute.
data/pdfs/*
!data/pdfs/.gitkeep
data/extracted/images/*
!data/extracted/images/.gitkeep
vectorstore/*
!vectorstore/.gitkeep
