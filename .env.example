# Copy this file to .env and fill in your real key.
# python-dotenv loads .env automatically if you add `from dotenv import
# load_dotenv; load_dotenv()` at the top of app/api.py (left as a manual
# step so the project doesn't silently depend on a file that isn't there).

# Required: your OpenAI (or OpenAI-compatible) API key.
OPENAI_API_KEY=sk-...

# Optional: point this at a different OpenAI-compatible endpoint, e.g. a
# local model server like Ollama (http://localhost:11434/v1) or LM Studio.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: which chat model to use for generation.
GENERATION_MODEL=gpt-4o-mini
